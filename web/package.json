  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/three": "0.185.4",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
